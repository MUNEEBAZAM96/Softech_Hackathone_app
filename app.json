{
  "expo": {
    "name": "BudgetIQ AI",
    "slug": "budget-iq",
    "scheme": "budgetiq",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "supportsTablet": true,
      "deploymentTarget": "15.4",
      "bundleIdentifier": "com.anonymous.budgetiq-ai"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "package": "com.stake12sorganization.budgetiq"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@lottiefiles/dotlottie-react-native/plugin",
      [
        "expo-notifications",
        {
          "color": "#0F172A"
        }
      ],
      "expo-sqlite",
      "expo-web-browser"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "56302d85-b74b-4560-adf7-985d000fb777"
      }
    },
    "owner": "stake12s-organization"
  }
}
