# Copilot proxy (run: npm run server)
# Google Gemini API key (AI Studio) — NEVER commit real values.
GEMINI_API_KEY=

# Optional: port for server/index.js (default 3001)
COPILOT_PORT=3001

# Expo app: base URL of the copilot proxy (no token here).
# Same host/path base is used for POST /api/copilot and POST /api/daily-tip.
# iOS simulator: http://localhost:3001
# Android emulator: http://10.0.2.2:3001
# Physical device: http://<your-LAN-IP>:3001
EXPO_PUBLIC_COPILOT_API_URL=http://localhost:3001

EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_ZnJlc2gtZmF3bi0zMS5jbGVyay5hY2NvdW50cy5kZXYk

# RevenueCat public SDK key (platform-specific; use the iOS/Android *public* key).
# Get it from app.revenuecat.com → Project settings → API keys.
# RevenueCat public SDK key (platform-specific; use the iOS/Android *public* key).
EXPO_PUBLIC_REVENUECAT_API_KEY=test_EKRMfDxokbXlHsJeETOnhYatTdg

